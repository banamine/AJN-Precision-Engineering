+}
+
+.ajn-platform-shell .ajn-redesign-surface .ajn-nav-item-active :where(svg, span) {
+  color: var(--ajn-accent) !important;
+}
+
+.ajn-platform-shell .ajn-redesign-surface .ajn-nav-underline {
+  background: var(--ajn-accent) !important;
+}
+
+.ajn-platform-shell .ajn-redesign-surface .ajn-dock-control {
+  border: 1px solid var(--ajn-line);
+  background: var(--ajn-base) !important;
+  color: var(--ajn-text) !important;
+}
+
+.ajn-platform-shell .ajn-redesign-surface .ajn-dock-control:hover {
