+  --ajn-accent-hover: #F97316;
+  --ajn-live: #EF4444;
+  --ajn-on-accent: #0F1117;
+}
+
+.ajn-platform-shell .ajn-redesign-surface:where(.ajn-redesign-nav) {
+  background: var(--ajn-base) !important;
+  border-color: var(--ajn-line) !important;
+}
+
+.ajn-platform-shell .ajn-redesign-surface.ajn-dock {
+  min-height: 64px;
+  height: 64px;
